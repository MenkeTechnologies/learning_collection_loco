**/config/local.yaml
**/config/*.local.yaml
**/config/production.yaml

# Override the global `docs/` ignore — these are the hand-authored Cyberpunk
# HUD docs (index.html + report.html + theme assets) for GitHub Pages.
!docs/
!docs/**

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*